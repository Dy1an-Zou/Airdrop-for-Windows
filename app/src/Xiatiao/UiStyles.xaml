<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Winawdl.Xiatiao">
    <!-- Uiverse/Galaxy adaptations. Original authors, pinned source files and MIT
         notices are preserved under app/design-sources and app/licenses. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F3EE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFB"/>
    <SolidColorBrush x:Key="InkBrush" Color="#292923"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#696960"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DDDCD2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A65F16"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F5E8D1"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#943C2B"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>

    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8"
                               Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                               StrokeDashArray="2 1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Cards/Sujitkavaiya_mighty-pig-81.html: quiet rectangular surface. -->
    <Style x:Key="PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <!-- Buttons/AhSiber_great-gecko-98.html: outline/fill interaction. -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="#B4B3A7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#EAD8B9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource InkBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <!-- Inputs/alexruix_slippery-frog-10.html: 8px field and distinct focus. -->
    <Style x:Key="InputField" TargetType="TextBox">
        <Setter Property="Background" Value="#F3F2EC"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="#C8C7BD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="#D6B782"/>
        <Setter Property="SelectionOpacity" Value="0.6"/>
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="FieldBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Toggle-switches/gharsh11032000_green-liger-89.html (Harsh Gupta):
         17px em scale, blue track, full-height white thumb, shadow and 400ms cubic-bezier. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="local:SwitchMotion.Enabled" Value="True"/>
        <Setter Property="Width" Value="59.5"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Keyboard focus is drawn by the template only in keyboard input mode;
             a mouse click must not add WPF's separate focus-adornment outline. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- CSS clamps its 50px radius into a capsule. WPF Border
                             scales overlarge radii differently: use half the 34px height. -->
                        <Border x:Name="Track" Background="#9FCCFA" CornerRadius="17"/>
                        <Ellipse x:Name="Thumb" Width="34" Height="34" Fill="#FFFFFF"
                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                            <Ellipse.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" BlurRadius="20" Opacity="0.4"/></Ellipse.Effect>
                        </Ellipse>
                        <Border x:Name="KeyboardFocusOutline" Margin="-4" CornerRadius="21" BorderBrush="#0974F1"
                                BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#0974F1"/>
                            <Setter TargetName="Thumb" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="27.2"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:SwitchMotion.KeyboardFocusVisible" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="KeyboardFocusOutline" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Cards/Sujitkavaiya_mighty-pig-81: file shelf with native selection semantics. -->
    <Style x:Key="FileSelectionTile" TargetType="ListBoxItem">
        <Setter Property="Width" Value="160"/>
        <Setter Property="Margin" Value="0,0,10,12"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="ToolTip" Value="{Binding FullPath}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TileBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="TileBorder" Property="Padding" Value="7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IdleOnly" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsOnly" TargetType="Grid" BasedOn="{StaticResource IdleOnly}">
        <Setter Property="IsEnabled" Value="False"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                    <Condition Binding="{Binding Pending.Count}" Value="0"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FileTile" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger>
        </Style.Triggers>
    </Style>
    <!-- loaders/mrhyddenn_tasty-crab-98.html: thin track and fill, adapted
         to real WPF progress rather than the original looping animation. -->
    <Style x:Key="TransferProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="#DFCDAF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
