<Window x:Class="Winawdl.Xiatiao.XiatiaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Winawdl.Xiatiao"
        Title="Airdrop for Windows" Width="860" Height="900" MinWidth="640" MinHeight="720"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="WindowSizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveNameCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}"/>
    </Window.InputBindings>
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image x:Name="BrandLogo" Width="52" Height="52" Margin="0,0,13,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Airdrop for Windows" FontSize="23" FontWeight="SemiBold"/>
            </StackPanel>
            <ComboBox x:Name="LanguagePicker" Grid.Column="2" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code"
                      SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="104" Height="32" Padding="8,4" Margin="12,0,8,0"
                      FontSize="13" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" FocusVisualStyle="{StaticResource KeyboardFocus}"
                      ToolTip="{local:Loc '界面语言'}" AutomationProperties.Name="{local:Loc '界面语言'}"/>
            <Button Grid.Column="3" Content="{local:Loc '关于'}" Click="AboutClicked" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc '关于 Airdrop for Windows'}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelSurface}" Padding="22,20">
            <StackPanel>
                <Grid Margin="0,0,18,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="AirDropSwitch" Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource Switch}"
                                  VerticalAlignment="Center" AutomationProperties.Name="{local:Loc 'AirDrop 开关'}" ToolTip="{local:Loc '开启或关闭 AirDrop'}"/>
                    <!-- Match the settings viewport, including its scrollbar gutter. -->
                    <Border Grid.Column="2" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=SettingsScroller, Path=Visibility}" Value="Visible"/>
                                    <Condition Binding="{Binding ElementName=SettingsScroller, Path=ComputedVerticalScrollBarVisibility}" Value="Visible"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger></Style.Triggers>
                        </Style></Border.Style>
                    </Border>
                </Grid>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,8"/>
                <Button x:Name="SettingsButton" Content="{local:Loc '收起设置'}" Click="SettingsClicked" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" Padding="0,4" MinHeight="28" AutomationProperties.Name="{local:Loc '展开或收起设置'}"/>
                <ScrollViewer x:Name="SettingsScroller" MaxHeight="180" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,18,22">
                <Grid Style="{StaticResource SettingsOnly}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="{local:Loc 'AirDrop 名称'}" Target="{Binding ElementName=DeviceNameField}" Padding="0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                    <TextBox x:Name="DeviceNameField" Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                             Style="{StaticResource InputField}" AutomationProperties.Name="{local:Loc 'AirDrop 名称'}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="{local:Loc '保存'}" Command="{Binding SaveNameCommand}" Style="{StaticResource ActionButton}" MinWidth="72"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{local:Loc '这是附近设备会看到的名字。'}" Style="{StaticResource SecondaryText}" Margin="1,6,0,15"/>
                </Grid>
                <Grid Style="{StaticResource SettingsOnly}" Margin="0,0,0,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{local:Loc '储存位置'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SaveFolder, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputField}"
                             Margin="0,0,10,0" ToolTip="{Binding SaveFolder}" AutomationProperties.Name="{local:Loc '文件储存位置'}"/>
                    <Button Grid.Column="2" Content="{local:Loc '更改'}" Command="{Binding BrowseFolderCommand}" Style="{StaticResource ActionButton}" MinWidth="72"/>
                </Grid>
                <Grid Style="{StaticResource IdleOnly}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{local:Loc '开机自启动'}"/><TextBlock Text="{local:Loc '登录后隐藏在托盘，关闭窗口也会继续接收。'}" Style="{StaticResource SecondaryText}" Margin="0,4,16,0" TextWrapping="Wrap"/></StackPanel>
                    <ToggleButton x:Name="AutoStartSwitch" Grid.Column="1" IsChecked="{Binding AutoStart, Mode=TwoWay}" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc '开机自启动'}"/>
                </Grid>
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FBEDE7" BorderBrush="#D8A796" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </Border>

        <!-- Notifications/alexruix_gentle-octopus-87: sender + persistent action row. -->
        <ScrollViewer Grid.Row="3" MaxHeight="176" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Pending.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#D7C19B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource TransferProgress}" Margin="0,9,0,0"
                                                 Visibility="{Binding IsTransferring, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:Loc '接收进度'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVisibility}}">
                                    <Button Content="{local:Loc '拒绝'}" Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                                    <Button Content="{local:Loc '接收'}" Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource PanelSurface}" Margin="0,20,0,0" Padding="20,16,12,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,8,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{local:Loc '已接收'}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FileCountText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{local:Loc '打开文件夹'}" Command="{Binding OpenFolderCommand}" Style="{StaticResource QuietButton}"/>
                    <Button Grid.Column="2" Content="{local:Loc '发送文件'}" Click="SendClicked" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" AutomationProperties.Name="{local:Loc '发送文件到 Apple 设备'}"/>
                </Grid>
                <TextBlock x:Name="FileSelectionSummary" Grid.Row="1" Text="{local:Loc '空白处框选 · 文件可拖出 · 拖入文件发送'}" Style="{StaticResource SecondaryText}" Margin="1,0,8,11" TextWrapping="Wrap"/>
                <AdornerDecorator Grid.Row="2">
                <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectionMode="Extended" local:FileMarqueeSelection.Enabled="True"
                         Background="Transparent" BorderThickness="0" Padding="0,3,5,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource FileSelectionTile}"
                         SelectionChanged="FileSelectionChanged" PreviewMouseRightButtonDown="FileRightButtonDown"
                         MouseDoubleClick="FileDoubleClicked" PreviewKeyDown="FileKeyDown"
                         AutomationProperties.Name="{local:Loc '已接收文件，多选列表'}">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="FileMenuOpened">
                            <MenuItem x:Name="OpenFileMenu" Header="{local:Loc '打开'}" Click="OpenSelectedClicked" InputGestureText="Enter"/>
                            <MenuItem x:Name="RevealFileMenu" Header="{local:Loc '在文件夹中显示'}" Click="RevealSelectedClicked"/>
                            <Separator/>
                            <MenuItem x:Name="CopyFilesMenu" Header="{local:Loc '复制文件'}" Click="CopySelectedClicked" InputGestureText="Ctrl+C"/>
                            <MenuItem x:Name="CopyPathsMenu" Header="{local:Loc '复制路径'}" Click="CopyPathsClicked" InputGestureText="Ctrl+Shift+C"/>
                            <MenuItem x:Name="CopyToMenu" Header="{local:Loc '复制到…'}" Click="CopyToClicked"/>
                            <Separator/>
                            <MenuItem x:Name="RemoveHistoryMenu" Header="{local:Loc '从记录中移除'}" Click="RemoveSelectedClicked"/>
                            <MenuItem x:Name="RecycleFilesMenu" Header="{local:Loc '移到回收站…'}" Click="RecycleSelectedClicked" InputGestureText="Delete"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                        <StackPanel>
                                            <Border Height="76" Background="#EEEEE7" CornerRadius="4" ClipToBounds="True">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{local:Loc '文件'}" FontSize="11" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                            <Grid Margin="0,2,0,0">
                                            <TextBlock Text="{Binding TimeText}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{local:Loc '文件已移动或删除'}" Foreground="{StaticResource ErrorBrush}" FontSize="11">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            </Grid>
                                        </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>
                </AdornerDecorator>
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,24,20,35" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{local:Loc '文件会落在这里'}" FontSize="19" FontWeight="Medium" TextAlignment="Center"/>
                    <TextBlock Text="{local:Loc '在 iPhone 的分享菜单中选择 AirDrop，&#x0a;找到这台电脑，发送后在这里确认接收。'}" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" LineHeight="21" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="2,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Loc '关闭窗口后，软件会留在托盘。'}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{local:Loc '清空记录'}" Click="ClearHistoryClicked" Style="{StaticResource QuietButton}" FontSize="12" Padding="9,4" MinHeight="28" ToolTip="{local:Loc '只清除列表记录，不删除已接收的文件'}"/>
        </Grid>
    </Grid>
</Window>
